{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WeckPilot",
  "mainBinaryName": "weckpilot",
  "version": "1.0.1",
  "identifier": "de.little-tools.weckpilot.linux",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WeckPilot",
        "width": 700,
        "height": 650,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "shadow": false,
        "alwaysOnTop": false,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "copyright": "Copyright © 2026 Norbert Jander",
    "publisher": "Norbert Jander",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "WeckPilot – modern alarm clock for Linux",
    "longDescription": "WeckPilot is a modern alarm clock with a digital display, multiple alarms per day, weekly schedules, gradually increasing volume, and English/German interface languages.",
    "linux": {
      "deb": {
        "depends": [
          "systemd",
          "util-linux",
          "pkexec | policykit-1"
        ]
      },
      "rpm": {
        "depends": [
          "systemd",
          "util-linux",
          "polkit"
        ]
      }
    }
  }
}
